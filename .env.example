# Copy to .env for local development. Never commit the real .env.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# LOCAL / FIREWALLED LAN ONLY: trusted-network permits login-free device enrollment.
# INTERNET / PRODUCTION: use provisioned and set BOTH workspace tokens below.
ACCESS_MODE=trusted-network
COUNTER_ACCESS_TOKEN=
WAREHOUSE_ACCESS_TOKEN=

# Required to unlock Settings; no default administrator password exists.
# Use a unique value of at least 12 characters.
ADMIN_PASSWORD=

# Optional: >=32 random characters. If omitted, a random persistent key is
# generated in the private application_secrets database table.
SESSION_SECRET=

# Optional: random secret for the scheduled screenshot-retention endpoint.
RETENTION_CRON_TOKEN=

# Used only by docker compose. Use a strong URL-safe hex value in production.
POSTGRES_PASSWORD=

# Optional: browser tests target an already running application.
TEST_BASE_URL=http://127.0.0.1:3000
